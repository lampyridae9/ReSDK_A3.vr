{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "relicta://schemas/building-brief-v1",
  "title": "Relicta BuildingBrief v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "intent", "buildingType", "style", "floors", "capacity", "requirements", "preferences", "seed"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "intent": {"type": "string", "const": "create_building"},
    "buildingType": {"type": "string", "const": "poor_worker_dormitory"},
    "style": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["poor", "utilitarian"]}},
    "floors": {"type": "integer", "minimum": 1, "maximum": 2},
    "capacity": {
      "type": "object", "additionalProperties": false, "required": ["residents"],
      "properties": {"residents": {"type": "integer", "minimum": 1, "maximum": 16}}
    },
    "requirements": {
      "type": "object", "additionalProperties": false, "required": ["bedrooms", "entrances", "storage"],
      "properties": {
        "bedrooms": {"type": "integer", "minimum": 1, "maximum": 8},
        "entrances": {"type": "integer", "const": 1},
        "storage": {"type": "boolean"}
      }
    },
    "preferences": {
      "type": "object", "additionalProperties": false,
      "required": ["centralCorridor", "compact", "bedroomsAwayFromEntrance"],
      "properties": {
        "centralCorridor": {"type": "boolean"},
        "compact": {"type": "boolean"},
        "bedroomsAwayFromEntrance": {"type": "boolean"}
      }
    },
    "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647}
  }
}
