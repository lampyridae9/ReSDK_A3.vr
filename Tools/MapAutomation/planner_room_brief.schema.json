{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "relicta.mapautomation/planner-room-brief-v1",
  "title": "Structured Room Brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "intent",
    "roomType",
    "style",
    "capacity",
    "requirements",
    "preferences",
    "seed"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "intent": {
      "type": "string",
      "const": "create_room"
    },
    "roomType": {
      "type": "string",
      "enum": ["bedroom"]
    },
    "style": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["poor", "utilitarian", "neutral"]
      }
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["people"],
      "properties": {
        "people": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sleeping",
        "storage",
        "lighting"
      ],
      "properties": {
        "sleeping": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "storage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "lighting": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1
        }
      }
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workSurface",
        "seating",
        "compact"
      ],
      "properties": {
        "workSurface": {
          "type": "boolean"
        },
        "seating": {
          "type": "boolean"
        },
        "compact": {
          "type": "boolean"
        }
      }
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    }
  }
}